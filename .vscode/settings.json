{
	"js/ts.preferences.quoteStyle": "single",
	"js/ts.format.enabled": true,
	"js/ts.format.insertSpaceBeforeFunctionParenthesis": true,
	"js/ts.format.insertSpaceAfterConstructor": true,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
	"js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
	"karmaTestExplorer.projectType": "karma",
	"karmaTestExplorer.autoWatchEnabled": false,
	"karmaTestExplorer.debuggerConfig": {
		"name": "Debug tests",
		"type": "chrome",
		"request": "attach",
		"port": 9222,
		"browserAttachLocation": "workspace",
		"address": "127.0.0.1",
		"timeout": 60000,
		"pathMapping": {
			"/": "${workspaceRoot}",
			"/base/": "${workspaceRoot}/"
		}
	},
	"css.format.newlineBetweenRules": false,
	"css.format.spaceAroundSelectorSeparator": true,
	"css.format.newlineBetweenSelectors": false
}